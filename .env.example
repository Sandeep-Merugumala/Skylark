# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it is in .gitignore.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# monday.com personal API token
# Profile picture → Developers → API Token
MONDAY_API_TOKEN=your-monday-token-here

# monday.com Board IDs
# Open the board → look at the URL: app.monday.com/boards/XXXXXXXXX
WORK_ORDERS_BOARD_ID=your-work-orders-board-id
DEALS_BOARD_ID=your-deals-board-id
